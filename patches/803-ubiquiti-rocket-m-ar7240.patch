Index: openwrt/package/kernel/mac80211/patches/ath9k/514-ath9k_add_ar7240_pci_id.patch
===================================================================
--- /dev/null
+++ openwrt/package/kernel/mac80211/patches/ath9k/514-ath9k_add_ar7240_pci_id.patch
@@ -0,0 +1,20 @@
+--- a/drivers/net/wireless/ath/ath9k/pci.c
++++ b/drivers/net/wireless/ath/ath9k/pci.c
+@@ -773,6 +773,7 @@ static const struct pci_device_id ath_pc
+ #endif
+ 
+ 	{ PCI_VDEVICE(ATHEROS, 0xabcd) }, /* PCI-E  internal chip default ID */
++	{ PCI_VDEVICE(ATHEROS, 0xff1c) }, /* AR7240 PCI uninitialized EEPROM */
+ 	{ 0 }
+ };
+ 
+--- a/drivers/net/wireless/ath/ath9k/hw.c
++++ b/drivers/net/wireless/ath/ath9k/hw.c
+@@ -664,6 +664,7 @@ int ath9k_hw_init(struct ath_hw *ah)
+ 	/* These are all the AR5008/AR9001/AR9002/AR9003 hardware family of chipsets */
+ 	switch (ah->hw_version.devid) {
+ 	case AR9300_DEVID_INVALID:
++	case 0xff1c:
+ 	case AR5416_DEVID_PCI:
+ 	case AR5416_DEVID_PCIE:
+ 	case AR5416_AR9100_DEVID:
